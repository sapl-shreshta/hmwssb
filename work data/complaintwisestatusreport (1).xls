<script type="text/javascript">
//<![CDATA[
function GetHiddenField(val)
                    {
                     var hidid='';
                      var hids=document.getElementsByTagName('input');                     
                       for(var i=0;i<hids.length;i++)
                         {
                         if(hids[i].type=='hidden') 
                         { 
                          if(hids[i].value==val)
                            hidid= hids[i].id;
                         } 
                         }
                         return hidid.replace('_GCID','$divContent');
                 
                      }



                  function SetScroll()
                 {

                if(document.getElementById('ctl00_SCROLLPOS')!=null)
               {
                var pbs=document.getElementById('ctl00_pnlBodyScroll');
                if(pbs!=null)
                {
                 pbs.scrollTop=document.getElementById('ctl00_SCROLLPOS').value;
                }      
               }
                  if (document.getElementById('ctl00_GRIDSCROLL') != null)
                  {
                      var gsdata = document.getElementById('ctl00_GRIDSCROLL').value;
                      
                        if(gsdata=='')
                        return ;
                     
                      var marray = gsdata.split(';');
                     
                        for(var i=0;i<marray.length;i++)
                        {
                            if(marray[i]!='')
                            {
                            var datas=marray[i].split(':');
                            var scrval=datas[1].split(',');
                              
                            var hidid= GetHiddenField(datas[0]);
                           
                            document.getElementById(hidid).scrollLeft = scrval[0]; 
                            document.getElementById(hidid).scrollTop = scrval[1]; 
                            }
                    
                        }
                  }
                
              
               }

              window.setTimeout('SetScroll();',1);//]]>
</script>
